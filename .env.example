# Optional. Everything here can also be set on the Settings tab in the app,
# which writes to data/config.json and takes precedence over this file.
# Use this file if you prefer configuring before first run.
#   cp .env.example .env

# --- Required for chat, semantic search and media understanding -------------
# Get a key at https://aistudio.google.com/apikey
# Without it, ingest and every statistic still work; only the chat agent,
# semantic search and media descriptions are unavailable.
GEMINI_API_KEY=

# Where archives are stored. Each chat gets its own subdirectory here.
# DATA_DIR=

# --- Chat provider ------------------------------------------------------------
# Which model answers questions and writes SQL. Everything except "gemini"
# speaks the OpenAI chat-completions protocol.
#   gemini | groq | xai | openrouter | ollama | openai | custom
# Embeddings and media understanding always use Gemini regardless: most
# OpenAI-compatible hosts serve no embeddings endpoint.
CHAT_PROVIDER=gemini

# Key for the chat provider above. Not needed for gemini (uses GEMINI_API_KEY)
# or for a local ollama.
CHAT_API_KEY=

# Only needed for CHAT_PROVIDER=custom; the others have known base URLs.
# CHAT_BASE_URL=https://api.groq.com/openai/v1

# The chat model. Switching provider in the UI sets a sensible default, and the
# Test button lists what your key can actually call.
GEMINI_CHAT_MODEL=gemini-2.5-flash

# --- Models -----------------------------------------------------------------
# Google renames and retires model ids regularly, so they are configuration,
# not code. Check what your key can actually call:
#     python -m app.cli models --all
# These two are Gemini-only: reading attachments, and building vectors.
GEMINI_HEAVY_MODEL=gemini-2.5-pro
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Embedding width. 768 is a good quality/size tradeoff; 1536 and 3072 are also
# valid for gemini-embedding-001. Changing this requires a full re-ingest,
# because existing vectors are stored at the old width.
EMBED_DIMS=768

# --- Conversation segmentation ----------------------------------------------
# Silence longer than this starts a new "conversation", which defines who
# counts as initiating one. 1-2 hours measures conversational bursts; 6-8
# measures who texts first each day. The chatbot can override this per question
# using the sessions_at() macro, so this is only the default. Applies to new
# ingests; existing archives keep the value they were built with.
SESSION_GAP_HOURS=4

# --- Retrieval ---------------------------------------------------------------
# Messages per retrieval window, and how much consecutive windows overlap.
CHUNK_SIZE=25
CHUNK_OVERLAP=5
EMBED_BATCH_SIZE=64
TOP_K=12

# Row cap on any single agent query, to protect the model's context window.
MAX_SQL_ROWS=500
# How many tool calls the agent may make before it must answer.
AGENT_MAX_STEPS=6

# --- Media understanding ------------------------------------------------------
# Describe photos, transcribe voice notes, read documents. This is the part
# that costs money on a large archive; run `python -m app.cli estimate <zip>`
# first to size it up.
DESCRIBE_MEDIA=true
TRANSCRIBE_AUDIO=true
# Parallel Gemini calls. Raise for speed, lower if you hit rate limits.
MEDIA_CONCURRENCY=4
# Videos larger than this are catalogued but not analysed.
MAX_VIDEO_MB=200
